<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="StyleAppButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="StyleTransparentButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@drawable/background_transparent_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StylePurpleButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@color/purple</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Widget.App.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CustomProgressLoading" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@color/transparent_50</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

</resources>