<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_black_radius"
    android:padding="@dimen/size17">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/set_theme"
        android:textColor="@color/white"
        android:textSize="@dimen/size20"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDark"
        style="@style/CustomTextDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dark"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvLight"
        style="@style/CustomTextDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/light"
        app:layout_constraintTop_toBottomOf="@id/tvDark" />

    <TextView
        android:id="@+id/tvSystem"
        style="@style/CustomTextDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/system"
        app:layout_constraintTop_toBottomOf="@id/tvLight" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size10"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:padding="@dimen/size13"
        android:text="@string/cancel"
        android:textColor="@color/purple2"
        android:textSize="@dimen/size17"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvSystem" />

</androidx.constraintlayout.widget.ConstraintLayout>