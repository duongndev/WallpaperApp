<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<!--    <FrameLayout-->
<!--        android:id="@+id/frAdsNative"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent">-->

<!--        <include-->
<!--            android:id="@+id/shimmerContainerNative"-->
<!--            layout="@layout/loading_native_fullscreen_view" />-->
<!--    </FrameLayout>-->

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginTop="@dimen/size28"
        android:layout_marginEnd="@dimen/size10"
        android:background="@drawable/background_circle_button_selector"
        android:src="@drawable/ic_close_2"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCountDown"
        android:layout_width="@dimen/size28"
        android:layout_height="@dimen/size28"
        android:layout_marginTop="@dimen/size34"
        android:layout_marginEnd="@dimen/size16"
        android:background="@drawable/background_count_down"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="@dimen/size17"
        android:visibility="gone"
        app:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutLoadingAds"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dialog_loading"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="5dp"
        android:paddingVertical="20dp">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="@dimen/size45"
            android:layout_height="@dimen/size45"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/custom_progress" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/loading_ads"
            android:textColor="@color/text_color_loading"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
