<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/size88"
    android:background="@color/color_main">

    <Space
        android:id="@+id/space"
        android:layout_width="@dimen/size10"
        android:layout_height="@dimen/size24"
        android:layout_marginBottom="@dimen/size15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/size30"
        android:layout_height="@dimen/size30"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_back"
        android:visibility="gone"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintStart_toEndOf="@+id/space"
        app:layout_constraintTop_toTopOf="@+id/space" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size10"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/white"
        android:text="@string/app_name"
        android:textSize="@dimen/size20"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toStartOf="@+id/btnSearch"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/space" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnSearch"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_search"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toStartOf="@+id/btnFav"
        app:layout_constraintTop_toTopOf="@+id/space" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnFav"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        app:srcCompat="@drawable/ic_favorite_selected"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toStartOf="@+id/btnSetting"
        app:layout_constraintTop_toTopOf="@+id/space" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnSetting"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginEnd="@dimen/size10"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="visible"
        app:srcCompat="@drawable/ic_settings"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space" />


    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="0dp"
        android:layout_height="@dimen/size40"
        android:layout_marginHorizontal="@dimen/size10"
        android:background="@drawable/bg_search_round"
        android:visibility="gone"
        app:iconifiedByDefault="false"
        app:queryHint="Tìm kiếm..."
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toStartOf="@+id/btnCloseSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnCloseSearch"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginEnd="@dimen/size10"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_close"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space" />

</androidx.constraintlayout.widget.ConstraintLayout>