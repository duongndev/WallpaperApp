<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".component.preview.activity.PreviewActivity">

    <!-- Wallpaper full screen -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="Wallpaper preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/size17"
        android:paddingEnd="@dimen/size17"
        android:paddingTop="@dimen/size40"
        android:paddingBottom="@dimen/size17"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size30"
            android:layout_height="@dimen/size30"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            app:tint="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnFav"
            android:layout_width="@dimen/size30"
            android:layout_height="@dimen/size30"
            android:src="@drawable/ic_favorite"
            android:scaleType="fitCenter"
            app:tint="@color/red" />

    </LinearLayout>

    <!-- Bottom control panel -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="@dimen/size17"
        android:paddingEnd="@dimen/size17"
        android:paddingTop="@dimen/size40"
        android:paddingBottom="@dimen/size30"
        android:background="@drawable/bg_preview_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_preview"
            android:textColor="@color/white"
            android:textSize="@dimen/size17"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size10"
            android:text="@string/make_your_screen_look_amazing"
            android:textColor="#BDBDBD"
            android:textSize="@dimen/size13" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size54"
            android:layout_marginTop="@dimen/size20"
            android:text="@string/set_wallpaper"
            android:textAllCaps="false"
            android:textSize="@dimen/size13"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/size14"
            app:backgroundTint="@color/color_main" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
